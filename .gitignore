# --- Build output -----------------------------------------------------------
obj-*/
_build/
build/
*.o
*.so
*.so.*
*.a
meson-info/
meson-logs/
meson-private/
compile_commands.json

# --- Debian packaging build artifacts ---------------------------------------
# These are generated by debhelper/dpkg-buildpackage and must never be committed.
# debian/files is tracked upstream but is itself a build artifact; it is
# intentionally ignored here to avoid committing local build metadata.
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.debhelper
debian/libfprint-2-tod-vfs0090/
debian/tmp/
debian/*.deb
debian/*.ddeb
debian/*.changes
debian/*.buildinfo

# --- Release artifacts ------------------------------------------------------
# Built .deb files are published as GitHub Release assets, never committed.
*.deb
*.ddeb
*.buildinfo
*.changes

# --- Lenovo / Validity firmware blobs ---------------------------------------
# Downloaded from Lenovo; proprietary and not redistributable. Never commit.
# See BUILD-UBUNTU-26.04.md for how to obtain these yourself.
*.xpfwext
*.exe
n1cgn*.exe
*.fw
firmware/
*.bin

# --- Validity sensor device state / calibration -----------------------------
# Generated by validity-sensors-tools. Contains per-device calibration,
# Host GUID and other device-specific state. Never commit.
*.db
*.sqlite
*.sqlite3
*.guid
host-guid*
HostGUID*
*.calib
*.calibration
calibration/
db/
state/
*.log

# --- Biometric data ---------------------------------------------------------
# Fingerprint templates and prints. Never commit, ever.
*.print
*.prints
*.fprint
*.template
*.templates
*.bmp
*.pgm
*.pgmz
*.raw
prints/

# --- Secrets / credentials --------------------------------------------------
.env
.env.*
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
.netrc
.git-credentials
*_token
*_secret

# --- Editors / misc ---------------------------------------------------------
*~
*.swp
*.swo
.DS_Store
.idea/
.vscode/
